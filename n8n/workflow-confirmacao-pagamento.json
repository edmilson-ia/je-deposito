{
  "name": "JE - Confirmação de pagamento",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "webhook-confirmacao",
      "name": "Recebe confirmação do site",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-400, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "je-confirmacao-pagamento",
        "responseMode": "onReceived",
        "options": {}
      },
      "notes": "Chamado automaticamente pelo backend (N8N_CONFIRMACAO_WEBHOOK_URL) quando o admin confirma o pagamento de um pedido no painel. A baixa de estoque já acontece no backend — aqui só avisamos o cliente."
    },
    {
      "id": "validar-segredo",
      "name": "Validar segredo do webhook",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-180, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "enviar-confirmacao",
      "name": "Enviar confirmação via Avisa API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, -80],
      "parameters": {
        "method": "POST",
        "url": "https://www.avisaapi.com.br/api/actions/sendMessage",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.body.telefone, message: `Pagamento confirmado, ${$json.body.nome}! Seu pedido #${$json.body.pedido_id.slice(0,8)} (R$ ${Number($json.body.total).toFixed(2)}) já está sendo separado. Obrigado pela preferência!` }) }}"
      },
      "notes": "Credencial httpHeaderAuth: Authorization = <AVISA_API_KEY>."
    }
  ],
  "connections": {
    "Recebe confirmação do site": {
      "main": [[{ "node": "Validar segredo do webhook", "type": "main", "index": 0 }]]
    },
    "Validar segredo do webhook": {
      "main": [[{ "node": "Enviar confirmação via Avisa API", "type": "main", "index": 0 }]]
    }
  }
}
