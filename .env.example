# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Painel admin (login só com senha)
ADMIN_PASSWORD=
ADMIN_RECOVERY_EMAIL=
SESSION_SECRET=

# Painel de preços (separado do admin acima) — login fixo usuário+senha
PRECOS_USUARIO=
PRECOS_SENHA=

# E-mail transacional (recuperação de senha do admin)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# WhatsApp — Avisa API (avisaapi.com.br)
AVISA_API_URL=
AVISA_API_KEY=

# Pix — chave usada para gerar a cobrança
PIX_KEY_TYPE=
PIX_KEY_VALUE=
PIX_RECEIVER_NAME=
PIX_RECEIVER_CITY=

# Planilha Google Sheets (fonte editável do catálogo)
GOOGLE_SHEETS_ID=

# Número de WhatsApp exibido no site (público, sem segredo) — formato DDI+DDD+número
VITE_WHATSAPP_NUMERO=
# Link do grupo de WhatsApp de promoções (botão "Promoções" na tela inicial)
VITE_WHATSAPP_GRUPO_PROMOCOES=

# n8n (self-host na VPS) — segredo para validar chamadas de webhook recebidas
N8N_WEBHOOK_SECRET=
# URL do webhook do n8n a chamar quando o admin confirma um pagamento manualmente
N8N_CONFIRMACAO_WEBHOOK_URL=

# Porta do servidor Express (produção: a porta interna atrás do Nginx, ex: 3000)
PORT=3001
NODE_ENV=development
